#!/bin/sh
# Luckfox init script: start the LoRa packet hub at boot.
# Install: cp to /etc/init.d/ and chmod +x. Buildroot's rcS runs S* scripts in order.
HUB=/root/packet_hub.py
case "$1" in
  start|"")
    # mount the SD if it isn't already (the hub also tries, but do it early)
    [ -b /dev/mmcblk1p1 ] && ! mountpoint -q /mnt/sdcard 2>/dev/null && \
      { mkdir -p /mnt/sdcard; mount -t vfat /dev/mmcblk1p1 /mnt/sdcard 2>/dev/null; }
    # heartbeat blink on the first onboard LED so "board is on" is visible immediately
    for t in /sys/class/leds/*/trigger; do [ -e "$t" ] && echo heartbeat > "$t" 2>/dev/null && break; done
    # fall back to the copy on the SD if none is in /root
    [ -f "$HUB" ] || HUB=/mnt/sdcard/lora/packet_hub.py
    [ -f "$HUB" ] && python3 "$HUB" >/tmp/packet_hub.log 2>&1 &
    ;;
  stop)
    kill "$(pidof python3)" 2>/dev/null
    ;;
  *)
    echo "usage: $0 {start|stop}"; exit 1;;
esac
exit 0
