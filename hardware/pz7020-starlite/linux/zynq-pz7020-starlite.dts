// SPDX-License-Identifier: GPL-2.0+
/*
 * Puzhi PZ7020-StarLite -- Zynq XC7Z020-CLG400-2, 512 MB DDR3L (one MT41K256M16, 16-bit)
 *
 * Every line is from the vendor documents or the hardware-validated PS configuration:
 *   User Manual V1.0 Parts 3.2 (33.333 MHz PS clock), 3.5 (GEM0 on MIO16-27, MDIO 52/53),
 *   3.6 (QSPI W25Q128JV on MIO1-6), 3.10 (UART0 MIO10/11), 3.11 (SD0 MIO40-45, no CD/WP),
 *   3.12 (USB0 ULPI MIO28-39, reset MIO46); schematic sheets 15/16 (PHY addresses 1 and 2);
 *   ps7/ps7_parameters_validated.json (DDR 16-bit, HIGHADDR 0x1FFFFFFF = 512 MB).
 * Same file serves U-Boot (dts/upstream or arch/arm/dts) and Linux (arch/arm/boot/dts/xilinx).
 */
/dts-v1/;
#include "zynq-7000.dtsi"
#include <dt-bindings/gpio/gpio.h>

/ {
	model = "Puzhi PZ7020-StarLite";
	compatible = "puzhi,pz7020-starlite", "xlnx,zynq-7000";

	aliases {
		ethernet0 = &gem0;
		serial0 = &uart0;
		mmc0 = &sdhci0;
		spi0 = &qspi;
		usb0 = &usb0;
	};

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x20000000>;	/* 512 MB: PCW_DDR_RAM_HIGHADDR 0x1FFFFFFF */
	};

	chosen {
		bootargs = "earlycon";
		stdout-path = "serial0:115200n8";
	};

	usb_phy0: phy0 {
		#phy-cells = <0>;
		compatible = "usb-nop-xceiv";
		reset-gpios = <&gpio0 46 GPIO_ACTIVE_LOW>;	/* USBPHY_nRSET = MIO46 [M 3.12] */
	};
};

&clkc {
	ps-clk-frequency = <33333333>;		/* Y1 33.33 MHz [M 3.2, sch 4] */
};

&gem0 {
	status = "okay";
	phy-mode = "rgmii-id";			/* RTL8211F-CG U15, straps not fixed -> try -id first, then "rgmii" */
	phy-handle = <&ethernet_phy>;

	ethernet_phy: ethernet-phy@1 {		/* PHY_AD[2:0] = 001 [sch 15] */
		reg = <1>;
		device_type = "ethernet-phy";
		realtek,clkout-disable;		/* as in the validated PetaLinux build */
		realtek,aldps-enable;
	};
};

&qspi {
	status = "okay";
	flash@0 {
		compatible = "jedec,spi-nor";	/* W25Q128JV, 16 MB [M 3.6] */
		reg = <0>;
		spi-max-frequency = <50000000>;
		spi-tx-bus-width = <1>;
		spi-rx-bus-width = <4>;
		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;
			partition@0 {
				label = "boot";		/* boot.bin + u-boot.img */
				reg = <0x0 0x500000>;
			};
			partition@500000 {
				label = "env";
				reg = <0x500000 0x20000>;
			};
			partition@520000 {
				label = "kernel";
				reg = <0x520000 0xa00000>;
			};
			partition@f20000 {
				label = "spare";
				reg = <0xf20000 0xe0000>;
			};
		};
	};
};

&sdhci0 {
	status = "okay";			/* microSD on MIO40-45, no card-detect or write-protect line [M 3.11] */
	broken-cd;
	disable-wp;
};

&uart0 {
	status = "okay";			/* CH340E console, MIO10 RX / MIO11 TX, 115200 [M 3.10] */
};

&usb0 {
	status = "okay";			/* USB3320C ULPI on MIO28-39, host [M 3.12] */
	dr_mode = "host";
	usb-phy = <&usb_phy0>;
};
