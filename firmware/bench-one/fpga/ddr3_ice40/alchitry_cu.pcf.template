# ===========================================================================================
#  alchitry_cu.pcf -- pin constraints for ddr3_top on an Alchitry Cu (iCE40-HX8K-CB132)
# ===========================================================================================
#
#  THIS FILE IS A TEMPLATE AND WILL NOT BUILD AS IT STANDS.
#
#  The pin letters below are deliberately left as PLACEHOLDERs. The Alchitry Cu's ball assignments
#  are published by Alchitry in their own cu.pcf, and inventing them here would be worse than
#  useless: a wrong ball on a DDR3 data line is a short between a 1.5 V part and a 3.3 V driver.
#  Copy the ball names from Alchitry's cu.pcf, which maps their silkscreen labels (A2, B14, C9 and
#  so on) to CB132 balls, and fill them in.
#
#  WIRING RULES THAT MATTER MORE THAN THE PIN CHOICE
#  ------------------------------------------------
#  1. Keep all eleven DDR3 DQ-side lines (DQ0..7, DQS, plus returns) on the SAME bank and the same
#     edge of the board, as short and as equal in length as you can manage. These are the only
#     lines where skew costs data; the address and command lines are updated a half memory period
#     early and have 20 ns of slack at 25 MHz.
#  2. Give CK and CK# adjacent pins. They are a differential pair and want to run together.
#  3. Every signal wants a ground return beside it. With flying leads that means a ground wire
#     every few signals, not one ground for the whole harness.
#  4. The Teensy side is 3.3 V and connects directly. The DDR3 side is 1.5 V and every line needs
#     translation: dividers are fine for the output-only lines, but DQ and DQS are bidirectional
#     and need real level shifters.
#
# ===========================================================================================

# ---- clock and reset ----
set_io clk          PLACEHOLDER   # 100 MHz board oscillator
set_io rst_n        PLACEHOLDER   # reset button, active low

# ---- Teensy FlexSPI2, 3.3 V, direct connection ----
set_io qspi_sck     PLACEHOLDER   # <- Teensy pin 53
set_io qspi_cs_n    PLACEHOLDER   # <- Teensy pin 51  (chip select 1, the free one)
set_io qspi_io[0]   PLACEHOLDER   # <-> Teensy pin 52
set_io qspi_io[1]   PLACEHOLDER   # <-> Teensy pin 49
set_io qspi_io[2]   PLACEHOLDER   # <-> Teensy pin 50
set_io qspi_io[3]   PLACEHOLDER   # <-> Teensy pin 54

# ---- DDR3, through level translation. DIMM contact numbers are for a 240-pin DDR3 UDIMM. ----
set_io ddr_ck_p     PLACEHOLDER   # contact 184
