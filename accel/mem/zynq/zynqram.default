# /etc/default/zynqram -- how much of the Zynq's DDR3 the Orange Pi gets as swap, in MiB.
# Read at boot by zynqram-prep.service; a change takes effect on the next Zynq boot.
# The board has 512 MB (one x16 MT41K256M16); Linux keeps 256 MB of it (the engine has 224 MB at
# 0x10000000, the GPU 32 MB at 0x1E000000 -- SPEC section 3). This much is allocated up front and never
# given back. Measured on QEMU at 512 MB: Linux and every service use ~42 MB, so 128 leaves ~80 MB free.
ZACCEL_SWAP_MB=128
