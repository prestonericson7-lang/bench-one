// SPDX-License-Identifier: GPL-2.0+
/*
 * Puzhi PZ7020-StarLite -- Zynq XC7Z020-CLG400-2, 512 MB DDR3L: ONE MT41K256M16TW-107IT:P (4 Gbit x16)
 *   on a 16-bit bus. Proof: schematic DDR sheet (only DQ0-15, DQS0/1, DM0/1, A0-A14 wired; part
 *   MT41K256M16TW-107IT:P), the vendor bundle's only DRAM datasheet, the vendor photo's chip marking
 *   D9SHG = MT41K256M16TW-107 IT:P. (The photo's '1GB' label is wrong: no A15 line, no second chip.)
 *   The 32-bit / 1 GB PS config was silent on this board on 2026-09-26; the 16-bit one boots.
 *
 * Every line is from the vendor documents or the hardware-validated PS configuration:
 *   User Manual V1.0 Parts 3.2 (33.333 MHz PS clock), 3.5 (GEM0 on MIO16-27, MDIO 52/53),
 *   3.6 (QSPI W25Q128JV on MIO1-6), 3.10 (UART0 MIO10/11), 3.11 (SD0 MIO40-45, no CD/WP),
 *   3.12 (USB0 ULPI MIO28-39, reset MIO46); schematic sheets 15/16 (PHY addresses 1 and 2);
 *   ps7/ps7_init_gpl.c (16-bit DDR, 512 MB) -- the PS configuration that ran on this board.
 * Same file serves U-Boot (dts/upstream or arch/arm/dts) and Linux (arch/arm/boot/dts/xilinx).
 */
/dts-v1/;
#include "zynq-7000.dtsi"
#include <dt-bindings/gpio/gpio.h>

/ {
	model = "Puzhi PZ7020-StarLite";
	compatible = "puzhi,pz7020-starlite", "xlnx,zynq-7000";

	aliases {
		ethernet0 = &gem0;
		ethernet1 = &gem1;
		serial0 = &uart0;
		mmc0 = &sdhci0;
		spi0 = &qspi;
		usb0 = &usb0;
	};

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x20000000>;	/* 512 MB: one x16 MT41K256M16 on a 16-bit bus (ps7/ps7_init_gpl.c) */
	};

	/* DDR3 the PL owns, so Linux never allocates it (accel/SPEC.md §3, accel/gpu/SPEC.md §10):
	 * the GPU's framebuffers, sprite pool and frame-return buffer, and the matrix engine's tensor
	 * store and DMA staging. Linux keeps 0x00000000-0x0FFFFFFF (256 MB; measured on QEMU at 512 MB: Linux
	 * and every service use ~42 MB, the zynqram export 128 MB). The GPU window is fixed in the PL. */
	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;
		gpu@1e000000 {
			reg = <0x1e000000 0x2000000>;		/* 32 MB  */
			no-map;
		};
		zaccel@10000000 {
			reg = <0x10000000 0xe000000>;		/* 224 MB */
			no-map;
		};
	};

	chosen {
		bootargs = "earlycon";
		stdout-path = "serial0:115200n8";
	};

	usb_phy0: phy0 {
		#phy-cells = <0>;
		compatible = "usb-nop-xceiv";
		reset-gpios = <&gpio0 46 GPIO_ACTIVE_LOW>;	/* USBPHY_nRSET = MIO46 [M 3.12] */
	};
};

&clkc {
	ps-clk-frequency = <33333333>;		/* Y1 33.33 MHz [M 3.2, sch 4] */
};

&gem0 {
	status = "okay";
	/* rgmii-id: the PHY adds both 2 ns RGMII delays. The Zynq GEM on MIO has no delay of its own and a
	 * 2 ns PCB delay would be ~30 cm of extra clock trace, so the delays come from the PHY; every mainline Zynq board
	 * with an RGMII PHY on MIO uses rgmii-id. Linux's built-in Realtek driver (CONFIG_REALTEK_PHY=y)
	 * programs RTL8211F TX/RX delay from this value and ignores the straps, so "rgmii" would switch
	 * both delays OFF (drivers/net/phy/realtek.c rtl8211f_config_init) -- not a fallback to try. */
	phy-mode = "rgmii-id";			/* RTL8211F-CG U15 */
	phy-handle = <&ethernet_phy>;

	ethernet_phy: ethernet-phy@1 {		/* PHY_AD[2:0] = 001 [sch 15] */
		reg = <1>;
		device_type = "ethernet-phy";
		realtek,clkout-disable;		/* as in the validated PetaLinux build */
		realtek,aldps-enable;
	};
};

/* PL-side Gigabit Ethernet: GEM1 over EMIO -> AMD GMII-to-RGMII core in the fabric (MDIO address 8,
 * vivado/build_system.tcl) -> RTL8211F-CG U16 at MDIO address 2 [schematic sheet 16].
 * The MAC talks GMII to the converter; the converter talks RGMII to the PHY. */
&gem1 {
	/* off: the 16-bit PS config that boots this board does not clock GEM1 or FCLK1 (only the silent
	 * 32-bit one did). The bench uses ETH-PS (gem0) only. */
	status = "disabled";
	phy-mode = "gmii";
	phy-handle = <&pl_phy>;

	mdio {
		#address-cells = <1>;
		#size-cells = <0>;

		pl_phy: ethernet-phy@2 {		/* PHY_AD[2:0] = 010 [sch 16] */
			reg = <2>;
			device_type = "ethernet-phy";
		};

		gmii_to_rgmii: gmii-to-rgmii@8 {
			compatible = "xlnx,gmii-to-rgmii-1.0";
			reg = <8>;
			phy-handle = <&pl_phy>;
		};
	};
};

/* The PL register file (ps7-axi/pl_regs.v) on M_AXI_GP0 -- time master, LEDs, keys, fan.
 * Exposed as UIO so user space can mmap it without /dev/mem. */
&amba {
	pl_regs@40000000 {
		compatible = "generic-uio";
		reg = <0x40000000 0x1000>;
		status = "okay";
	};
	/* The matrix engine (accel/SPEC.md §2-3): its AXI DMA registers and its reserved DDR3.
	 * zaccel-server finds both by UIO name. Needs uio_pdrv_genirq.of_id=generic-uio (boot.cmd). */
	zaccel-dma@40400000 {
		compatible = "generic-uio";
		reg = <0x40400000 0x10000>;
		status = "okay";
	};
	zaccel-mem@10000000 {
		compatible = "generic-uio";
		reg = <0x10000000 0xe000000>;
		status = "okay";
	};
};

&qspi {
	status = "okay";
	flash@0 {
		compatible = "jedec,spi-nor";	/* W25Q128JV, 16 MB [M 3.6] */
		reg = <0>;
		spi-max-frequency = <50000000>;
		spi-tx-bus-width = <1>;
		spi-rx-bus-width = <4>;
		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;
			partition@0 {
				label = "boot";		/* boot.bin + u-boot.img */
				reg = <0x0 0x500000>;
			};
			partition@500000 {
				label = "env";
				reg = <0x500000 0x20000>;
			};
			partition@520000 {
				label = "kernel";
				reg = <0x520000 0xa00000>;
			};
			partition@f20000 {
				label = "spare";
				reg = <0xf20000 0xe0000>;
			};
		};
	};
};

&sdhci0 {
	bootph-all;				/* U-Boot SPL needs this node to read BOOT partition (u-boot.img) */
	status = "okay";			/* microSD on MIO40-45, no card-detect or write-protect line [M 3.11] */
	broken-cd;
	disable-wp;
};

&cpu0 {
	/* One operating point = the real CPU clock. The validated PS config runs the APU at
	 * 766.666666 MHz (PCW_APU_PERIPHERAL_FREQMHZ, same in ps7/ and ps7-vivado/). zynq-7000.dtsi
	 * lists only 666667/333334 kHz, so on the first hardware boot (2026-09-24) cpufreq found the CPU
	 * at 766666 kHz (oops r6 = 0xbb2ca), tried to change it, got -EBUSY from the clock driver and
	 * hit BUG_ON in cpufreq_online() -> "Attempted to kill init". With this table Linux never
	 * changes the clock ps7_init set. QEMU runs at 666667 kHz, so it cannot show this. */
	operating-points = <766666 1000000>;
};

&uart0 {
	bootph-all;				/* U-Boot SPL needs this node: without it the SPL has no console (as zynq-zybo-z7.dts / zynq-zc702.dts) */
	status = "okay";			/* CH340E console, MIO10 RX / MIO11 TX, 115200 [M 3.10] */
};

&usb0 {
	status = "okay";			/* USB3320C ULPI on MIO28-39, host [M 3.12] */
	dr_mode = "host";
	usb-phy = <&usb_phy0>;
};
