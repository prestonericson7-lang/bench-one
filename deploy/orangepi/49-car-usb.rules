# 49-car-usb.rules -- the car's USB microcontrollers on the Orange Pi.
# Serial ports readable/writable by the dialout group (the hub service runs in it), and ModemManager
# told not to probe them: it sends AT commands to every ttyACM port it sees, which a Teensy or an
# ESP32 would receive as input.

# Teensy (PJRC): USB serial, and the HalfKay bootloader so teensy_loader_cli can flash without root
ATTRS{idVendor}=="16c0", ATTRS{idProduct}=="04[789B]?", ENV{ID_MM_DEVICE_IGNORE}="1", ENV{ID_MM_PORT_IGNORE}="1"
ATTRS{idVendor}=="16c0", ATTRS{idProduct}=="04[789A]?", ENV{MTP_NO_PROBE}="1"
SUBSYSTEMS=="usb", ATTRS{idVendor}=="16c0", ATTRS{idProduct}=="04[789ABCD]?", MODE:="0666"
KERNEL=="ttyACM*", ATTRS{idVendor}=="16c0", ATTRS{idProduct}=="04[789B]?", MODE:="0666", GROUP="dialout"

# ESP32-S3 native USB (Espressif), and the common USB-UART bridges (CH34x, CP210x, FTDI)
ATTRS{idVendor}=="303a", ENV{ID_MM_DEVICE_IGNORE}="1", ENV{ID_MM_PORT_IGNORE}="1"
KERNEL=="ttyACM*|ttyUSB*", ATTRS{idVendor}=="303a|1a86|10c4|0403", MODE:="0660", GROUP="dialout"
ATTRS{idVendor}=="1a86|10c4|0403", ENV{ID_MM_DEVICE_IGNORE}="1", ENV{ID_MM_PORT_IGNORE}="1"
